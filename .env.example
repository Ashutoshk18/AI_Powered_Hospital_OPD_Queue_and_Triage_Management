# Environment Configuration Example
# Copy this file to .env and adjust values for your local environment

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opd_queue_db?schema=public

# Authentication / Security
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ML Prediction Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# CORS
CORS_ORIGIN=http://localhost:5173

# Administrative Bootstrap (First-time setup only)
INITIAL_ADMIN_EMAIL=admin@opd-hospital.org
INITIAL_ADMIN_PASSWORD=change_this_admin_password_on_first_login
